# Copy this file to backend/.env for local development only.
# Never commit populated environment files. Use a secret manager in production.

NODE_ENV=development
PORT=5000
CLIENT_URLS=http://localhost:5173

# MongoDB must be a replica set because claim, match, session, and item workflows use transactions.
MONGO_URI=mongodb://localhost:27017/smart-lost-found?replicaSet=rs0
REQUIRE_MONGO_REPLICA_SET=true
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_POOL_SIZE=30

# A production deployment should require Redis.
REDIS_URL=redis://localhost:6379/0
REQUIRE_REDIS=false

# Generate at least 32 random bytes; do not reuse this value anywhere else.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRE=15m
REFRESH_TOKEN_DAYS=7
ALLOW_BEARER_AUTH=false

COOKIE_SECURE=false
# Development/same-origin default. Split Vercel + Railway production requires "none" with COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Media provider. Required in production by default.
REQUIRE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configure either Resend or SMTP. In production, also set REQUIRE_EMAIL_PROVIDER=true
# and use an EMAIL_FROM sender address/domain verified by the selected provider.
REQUIRE_EMAIL_PROVIDER=false
EMAIL_FROM=Smart Lost & Found <noreply@example.invalid>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# Optional external image-analysis provider. Database search and matching still work when disabled.
AI_ENABLED=false
AI_CHAT_PROVIDER=auto
AI_VISION_PROVIDER=auto
AI_API_URL=
AI_API_KEY=
# Optional comma-separated failover lists. Singular variables above remain supported.
AI_API_KEYS=
# Backward-compatible OpenRouter aliases; prefer AI_API_KEY(S) for provider-neutral deployments.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_CHAT_MODEL=
OPENROUTER_CHAT_MODELS=
OPENROUTER_VISION_MODEL=
OPENROUTER_VISION_MODELS=
AI_CHAT_MODEL=
AI_CHAT_MODELS=
AI_VISION_MODEL=
AI_VISION_MODELS=
# OpenCode Zen vision example: muse-spark-1.3-contributor-free uses /responses automatically.
AI_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=3
AI_CATEGORY_TIMEOUT_MS=8000
AI_CATEGORY_MAX_ATTEMPTS=1
AI_USE_RESPONSE_FORMAT=false
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000

JOBS_ENABLED=true
APP_TIMEZONE=Asia/Colombo
JOB_TIMEZONE=Asia/Colombo
CLEANUP_BATCH_LIMIT=100
RESOLVED_RETENTION_DAYS=90
MATCH_CANDIDATE_DAYS=120
MATCH_CANDIDATE_LIMIT=250
MATCH_DATE_WINDOW_DAYS=90
MATCH_SAVE_THRESHOLD=50
MATCH_STRONG_THRESHOLD=70
# Direct dual-image provider comparison is restricted to the highest-ranked candidates.
MATCH_VISUAL_COMPARE_LIMIT=3
MATCH_VISUAL_COMPARE_FLOOR=35
PREDICTION_LOOKBACK_DAYS=365
PREDICTION_MINIMUM_SAMPLE=10
