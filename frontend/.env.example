# Same-origin production defaults used by the Docker/nginx deployment.
VITE_API_URL=/api
VITE_SOCKET_URL=

# For a split Vercel + Railway deployment, replace the two values above with
# the full HTTPS API domain, preferably under the same registrable domain:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
VITE_APP_NAME=Smart Lost & Found
VITE_APP_UNIVERSITY=SEUSL
VITE_GOOGLE_CLIENT_ID=
